---
/**
 * A cricket wicket mark plus the team name as a two-line wordmark.
 */
import { SITE } from "../config";

interface Props {
  class?: string;
}
const rest = SITE.name.replace(SITE.shortName, "").trim();
---

<span class:list={["logo inline-flex items-center gap-3", Astro.props.class]}>
  <svg viewBox="0 0 40 40" width="40" height="40" fill="none" aria-hidden="true" class="size-9 shrink-0 lg:size-10">
    <path d="M10 31V13M20 31V13M30 31V13" stroke="var(--c-ink)" stroke-width="2.2" stroke-linecap="round"></path>
    <path d="M8 13H32M10 9H18M22 9H30" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round"></path>
    <path d="M12 34H28" stroke="var(--c-ink)" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="text-[1.0625rem] font-semibold tracking-[0.16em] uppercase">{SITE.shortName}</span>
    {rest && <span class="mt-1 text-[0.6875rem] tracking-[0.32em] text-muted uppercase">{rest}<span class="text-accent">.</span></span>}
  </span>
</span>
