---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { SITE } from "../../config";
import { withBase } from "../../lib/site-path";
---

<BaseLayout
  title="Cricket"
  description={`Meet ${SITE.name}, a cricket team connected by the game and community across the Pacific Northwest.`}
>
  <PageHeader
    title="Cricket, played *together*"
    lead="The game is about more than the score. It is skill, strategy, teamwork, and the people you share it with."
  />

  <section class="section pt-10" aria-labelledby="club-details-title">
    <div class="container-x cricket-layout">
      <figure class="cricket-photo">
        <img src={withBase("/og.jpg")} alt="Cricket team group photograph" fetchpriority="high" />
      </figure>
      <div class="cricket-copy">
        <p class="eyebrow">The club</p>
        <h2 id="club-details-title">{SITE.name}</h2>
        <p>
          PNW Rhinos is a cricket team in the Pacific Northwest. We celebrate the energy of the game and the teamwork that makes
          every moment on the field matter.
        </p>
        <dl class="club-facts">
          <div><dt>Sport</dt><dd>Cricket</dd></div>
          <div><dt>Region</dt><dd>{SITE.areaServed}</dd></div>
        </dl>
        <a href={withBase("/contact/#enquiry")} class="btn btn-primary">Contact the team</a>
      </div>
    </div>
  </section>

  <section class="club-invitation" aria-labelledby="invitation-title">
    <div class="container-x invitation-content">
      <p class="eyebrow">Players, supporters, cricket friends</p>
      <h2 id="invitation-title">Start a conversation with the Rhinos.</h2>
      <p>For questions about the team, playing, or getting involved, send us a message.</p>
      <a href={withBase("/contact/#enquiry")} class="btn btn-secondary">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cricket-layout {
    display: grid;
    gap: 36px;
    align-items: center;
  }
  .cricket-photo {
    overflow: clip;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-media);
    background: var(--c-surface);
  }
  .cricket-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cricket-copy h2,
  .invitation-content h2 {
    margin-top: 12px;
    font-size: min(9vw, 64px);
    line-height: 1.08;
  }
  .cricket-copy > p:not(.eyebrow),
  .invitation-content > p:not(.eyebrow) {
    margin-top: 20px;
    color: var(--c-muted);
    font-size: 18px;
  }
  .club-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-block: 28px;
  }
  .club-facts div {
    padding: 16px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }
  .club-facts dt {
    color: var(--c-muted);
    font-size: 14px;
  }
  .club-facts dd {
    margin-top: 4px;
    font-weight: 700;
  }
  .club-invitation {
    padding-block: 72px;
    background: var(--c-surface);
  }
  .invitation-content {
    max-width: 760px;
    text-align: center;
  }
  .invitation-content .btn {
    margin-top: 28px;
  }
  @media (min-width: 900px) {
    .cricket-layout {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 72px;
    }
    .club-invitation {
      padding-block: 110px;
    }
  }
</style>
