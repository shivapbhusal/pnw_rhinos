---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { SITE } from "../config";

const members = [
  { title: "Players", text: "The people who bring skill, effort, and teamwork to the game." },
  { title: "Supporters", text: "The friends and fans who share the excitement of cricket." },
  { title: "Community", text: "Everyone connected by a love of cricket in the Pacific Northwest." },
];
---

<BaseLayout title="About" description={`${SITE.name} is a cricket team in the Pacific Northwest, connected by teamwork, respect, and a shared love of the game.`}>
  <PageHeader
    title="A team shaped by *cricket*"
    lead={`${SITE.name} brings the game and its community together across the Pacific Northwest.`}
  />

  <section id="history" class="section scroll-mt-28" aria-labelledby="history-title">
    <div class="container-x">
      <SectionHeading
        id="history-title"
        title="A story still *growing*"
        lead={`${SITE.name} is rooted in a shared love of cricket and community across the ${SITE.areaServed}. The club's story is built through the people who come together around the game.`}
      />
    </div>
  </section>

  <section id="members" class="section pt-0 scroll-mt-28" aria-labelledby="members-title">
    <div class="container-x">
      <SectionHeading id="members-title" title="The people behind the *team*" lead="A cricket club is more than the players on the field. It's a community that shares the game." />
      <ul class="stagger mt-14 grid gap-6 md:grid-cols-3">
        {members.map((value, i) => (
          <li class="card p-7" style={`--i:${i}`}>
            <h3 class="text-xl">{value.title}</h3>
            <p class="mt-3 text-muted">{value.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pb-24 lg:pb-36" aria-labelledby="contact-title">
    <div class="container-x">
      <div class="reveal rounded-3xl bg-accent p-8 text-accent-text sm:p-12 lg:p-16">
        <h2 id="contact-title" class="h-section">Cricket is better *together.*</h2>
        <p class="mt-6 max-w-2xl text-lg">Get in touch with PNW Rhinos to start a conversation about the team and the game.</p>
        <a href={SITE.cta.href} class="btn btn-dark btn-lg mt-12">Contact the team</a>
      </div>
    </div>
  </section>
</BaseLayout>
