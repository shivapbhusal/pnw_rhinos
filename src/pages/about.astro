---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { SITE } from "../config";
import { about } from "../data/about";
import { history } from "../data/history";
import { members, memberSection } from "../data/members";
---

<BaseLayout title="About" description={`${SITE.name} is a cricket team in the Pacific Northwest, connected by teamwork, respect, and a shared love of the game.`}>
  <PageHeader
    title={about.title}
    lead={about.lead.replaceAll("PNW Rhinos", SITE.name)}
  />

  <section id="history" class="section scroll-mt-28" aria-labelledby="history-title">
    <div class="container-x">
      <SectionHeading
        id="history-title"
        title={history.title}
        lead={history.lead.replaceAll("PNW Rhinos", SITE.name).replaceAll("Pacific Northwest", SITE.areaServed)}
      />
    </div>
  </section>

  <section id="members" class="section pt-0 scroll-mt-28" aria-labelledby="members-title">
    <div class="container-x">
      <SectionHeading id="members-title" title={memberSection.title} lead={memberSection.lead} />
      <ul class="stagger mt-14 grid gap-6 md:grid-cols-3">
        {members.map((value, i) => (
          <li class="card p-7" style={`--i:${i}`}>
            {value.photo ? (
              <img
                src={value.photo}
                alt={`${value.name}, ${value.role}`}
                class="mb-6 aspect-[4/5] w-full rounded-xl object-cover"
                
              />
            ) : (
              <div class="mb-6 flex aspect-[4/5] items-center justify-center rounded-xl border border-line bg-surface text-muted" aria-label={`No photo available for ${value.name}`}>
                <span>Photo</span>
              </div>
            )}

            

            <dl class="space-y-5">
              <div>
                <dt class="text-sm font-bold uppercase tracking-wider text-accent">Name</dt>
                <dd class="mt-1 text-xl">{value.name}</dd>
              </div>
              <div>
                <dt class="text-sm font-bold uppercase tracking-wider text-accent">Role</dt>
                <dd class="mt-1">{value.role}</dd>
              </div>
              <div>
                <dt class="text-sm font-bold uppercase tracking-wider text-accent">Profile</dt>
                <dd class="mt-1 text-muted">{value.profile}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pb-24 lg:pb-36" aria-labelledby="contact-title">
    <div class="container-x">
      <div class="reveal rounded-3xl bg-accent p-8 text-accent-text sm:p-12 lg:p-16">
        <h2 id="contact-title" class="h-section">Cricket is better *together.*</h2>
        <p class="mt-6 max-w-2xl text-lg">Get in touch with PNW Rhinos to start a conversation about the team and the game.</p>
        <a href={SITE.cta.href} class="btn btn-dark btn-lg mt-12">Contact the team</a>
      </div>
    </div>
  </section>
</BaseLayout>
