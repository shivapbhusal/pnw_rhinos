---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE } from "../config";
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${SITE.name} about cricket, the team, or the Pacific Northwest cricket community.`}
>
  <PageHeader
    title="Let's talk *cricket*"
    lead="Have a question for PNW Rhinos? Send the team a message using the form below."
  />

  <section class="contact-section" aria-label="Contact PNW Rhinos">
    <div class="container-x contact-wrap">
      <div class="contact-intro">
        <p class="eyebrow">Get in touch</p>
        <h2>We'd love to hear from you.</h2>
        <p>Ask us about the team, share a cricket question, or start a conversation about getting involved.</p>
      </div>
      <div id="enquiry" class="scroll-mt-28">
        <h2 class="sr-only">Send a message</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding-block: 48px 96px;
  }
  .contact-wrap {
    display: grid;
    gap: 36px;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .contact-intro h2 {
    margin-top: 12px;
    font-size: min(8vw, 52px);
    line-height: 1.1;
  }
  .contact-intro > p:last-child {
    max-width: 430px;
    margin-top: 18px;
    color: var(--c-muted);
    font-size: 18px;
  }
  @media (min-width: 900px) {
    .contact-section {
      padding-block: 80px 120px;
    }
    .contact-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 72px;
      align-items: start;
    }
  }
</style>
